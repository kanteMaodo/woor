# Copier ce fichier en .env pour le développement local. Ne jamais committer .env.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_HOST=127.0.0.1
API_PORT=3000

# Clé HMAC des codes de remise, 32 octets en base64 (même commande que PREIMAGE_KEYS ci-dessous).
CODE_HMAC_KEY=

# Connexion des vendeuses et livreurs : HMAC des numéros et « poivre » des PIN (32 octets en base64).
PHONE_HMAC_KEY=
PIN_PEPPER=

# Chiffrement des adresses de livraison (32 octets en base64).
PII_KEY=
PII_KEY_ID=1

# Application web : adresse de l'API, appelée par le serveur web uniquement.
API_URL=http://127.0.0.1:3000

# Base de données locale (infra/docker-compose.yml). Chaque service a son propre compte :
# jamais le superutilisateur, sinon la RLS ne protège plus rien.
API_DATABASE_URL=postgres://woor_api_app:woor_api_dev@localhost:5432/woor
WORKER_DATABASE_URL=postgres://woor_worker_app:woor_worker_dev@localhost:5432/woor
# Superutilisateur local, pour le script des comptes de démonstration seulement.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/woor

# Nœud LND du service de paiements (regtest local, par exemple avec Polar).
# Certificat TLS en base64, macaron à droits réduits en base64 ou en hexadécimal.
LND_SOCKET=127.0.0.1:10009
LND_CERT_BASE64=
LND_MACAROON=

# Clés AES-256 des secrets de déblocage, format "id:base64", séparées par des virgules.
# Générer une clé :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PREIMAGE_KEYS=1:
PREIMAGE_ACTIVE_KEY_ID=1

# Rythme du service de paiements
OUTBOX_POLL_INTERVAL_MS=1000
MAINTENANCE_INTERVAL_MS=60000
